# Force LF for shell scripts
*.sh text eol=lf

# Force LF for Python files
*.py text eol=lf

# Force LF for TOML/YAML config
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force LF for markdown/text
*.md text eol=lf
*.txt text eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
